# Local app settings
APP_ENV=development
DATABASE_URL=sqlite:///./data/raglab.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_MAX_BYTES=10485760

# xAI/Grok. Keep real values only in the root .env or a secret manager.
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=latest
XAI_BASE_URL=https://api.x.ai/v1

# Optional X API retrieval. This app reports disabled unless valid access is configured.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=raglab-ai-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

