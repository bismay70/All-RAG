# Local app settings
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:<percent-encoded-password>@<host>:5432/postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_MAX_BYTES=10485760

# Groq. Keep real values only in the root .env or a secret manager.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local embeddings stay independent of the LLM provider.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Optional X API retrieval. This app reports disabled unless valid access is configured.
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=raglab-ai-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

